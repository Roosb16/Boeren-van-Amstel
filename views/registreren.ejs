<!DOCTYPE html>
<html lang="nl">
  <head>
      <title>Registreren</title>
      <%- include('partials/head') %>
      <link rel="stylesheet" href="/css/inlog.css">
  </head>
  <body>
    <header>
      <%- include('partials/header-nav') %>
    </header>
    <main>
      <form method="POST" action="/registreren" class="inlogform">
            <section class="login">
                <img src="/img/profiel-foto.png" alt="Eendje">
              <h1>Meld je aan</h1>
              <div class="input-wrapper">
                <img src="/img/naam.png" alt="" class="input-icoon">
                <input type="text" name="naam" placeholder="Naam" required>
              </div>
              
        
              <div class="input-wrapper">
                <img src="/img/mail.png" alt="" class="input-icoon">
                <input type="email" name="email" placeholder="Email" required>
              </div>
        
              <div class="wachtwoord-wrapper">
                <img src="/img/ww.png" alt="" class="input-icoon">
                <input type="password" id="wachtwoord" name="wachtwoord" placeholder="Wachtwoord" required minlength="8">
                <span class="toggle-wachtwoord">
                  <img src="/img/oog-dicht.png" alt="Toon wachtwoord" class="oog">
                </span>
              </div>

              <% if (typeof fout !== 'undefined') { %>
                <p class="foutmelding"><%= fout %></p>
              <% } %>

              <input type="submit" value="Registreer">
              <p>Heb je al een account? <a href="/login">Login</a></p>
            </section>
        </form>
